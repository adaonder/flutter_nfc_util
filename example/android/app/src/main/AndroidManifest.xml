<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />

    <application
        android:label="NFC Util"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!--
          Background tag reading, on an alias rather than on MainActivity itself.

          The filters have to live in the application's manifest rather than in the plugin,
          because they name an activity of this app. They sit on an <activity-alias> for one
          reason: android:permission guards the WHOLE activity, and MainActivity also carries
          the LAUNCHER filter, so putting the attribute there would gate the launcher too.
          The alias takes the taps; MainActivity stays unguarded and still appears in the
          launcher. android:launchMode="singleTop" on MainActivity is what makes a tap deliver
          to the running instance instead of starting a second copy.

          android.permission.DISPATCH_NFC_MESSAGE is required from Android 17 (API 37) for an
          activity to be dispatched an NFC intent at all, when the app targets above API 36.
          Nothing is logged when it is missing; the tap simply does nothing, which is why the
          example's Capabilities button calls NfcUtilAndroid.checkTagIntentSetup().

          Safe on older devices, and measured rather than assumed. On both an API 37 Pixel and
          an API 28 phone, `adb shell dumpsys package` reports the permission as declared by
          the platform itself (sourcePackage=android, prot=signature|privileged) and held
          by the NFC system service (com.google.android.nfc / com.android.nfc,
          "DISPATCH_NFC_MESSAGE: granted=true"). So the service can still start a guarded
          activity on an old OS, while ordinary apps cannot. It is an existing platform
          permission newly *enforced* in API 37, not a new one.

          NDEF_DISCOVERED is the most specific and wins when the tag holds a matching message.
          TECH_DISCOVERED catches tags with no NDEF content at all.

          None of this touches reader mode or foreground dispatch, which are unaffected by
          every Android 16 and 17 change.
        -->
        <activity-alias
            android:name=".NfcEntryAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:permission="android.permission.DISPATCH_NFC_MESSAGE">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED"/>
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter"/>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
