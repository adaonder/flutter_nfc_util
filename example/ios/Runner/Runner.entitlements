<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  NDEF and TAG cover reader sessions. VAS is what NfcUtilIos.vasSessionBegin needs, and
	  it has to be enabled on the App ID in the developer portal as well; a provisioning
	  profile without it makes the session fail asynchronously through onError.
	-->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>NDEF</string>
		<string>TAG</string>
		<string>VAS</string>
	</array>
</dict>
</plist>
